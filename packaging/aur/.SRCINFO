pkgbase = slerp
	pkgdesc = Thumbnailer and viewer for 3D models, textures, game assets and other graphics
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/eric-frost/slerp
	arch = x86_64
	arch = aarch64
	license = MIT OR Apache-2.0
	makedepends = cargo
	makedepends = clang
	makedepends = cmake
	makedepends = qt6-base
	makedepends = wayland
	makedepends = libxkbcommon
	options = !lto
	options = !debug
	source = slerp-0.1.0.tar.gz::https://github.com/eric-frost/slerp/archive/v0.1.0.tar.gz
	sha256sums = SKIP

pkgname = slerp
	depends = libgcc
	depends = libstdc++
	depends = glibc
	depends = vulkan-icd-loader
	depends = wayland
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = libx11
	depends = libxcursor
	depends = libxi
	depends = hicolor-icon-theme
	optdepends = vulkan-swrast: 3D thumbnails without a GPU driver and in sandboxes that hide the GPU
	optdepends = libheif: HEIC pictures in the viewer
	optdepends = ghostscript: PostScript and EPS files that store no preview
	optdepends = slerp-qt-plugin: textures and turning models in Gwenview and Dolphin

pkgname = slerp-qt-plugin
	pkgdesc = Qt image plugin that shows Slerp's textures and models in Gwenview and Dolphin
	depends = slerp
	depends = qt6-base
	depends = libgcc
	depends = libstdc++
	depends = glibc
