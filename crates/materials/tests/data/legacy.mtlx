<?xml version="1.0"?>
<materialx version="1.37">
  <nodegraph name="NG1">
    <image name="img" type="color3">
      <parameter name="file" type="filename" value="usd/tex.png" />
    </image>
    <output name="out" type="color3" nodename="img" />
  </nodegraph>
  <material name="Legacy">
    <shaderref name="SR1" node="standard_surface">
      <bindinput name="base_color" type="color3" nodegraph="NG1" output="out" />
      <bindinput name="metalness" type="float" value="1" />
    </shaderref>
  </material>
</materialx>
