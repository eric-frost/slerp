		//endregion
		//region models-extra (assimp test models, 3MF Consortium samples, point clouds)
		// Entries with a nested dest (3mf-samples/core, pointclouds/pdal/las) and single-file entries keep each repository's LICENSE beside the data: a Git entry replaces its whole dest folder, and strip drops files at the repository root.
		// assimp-x-nonbsd is single files because README-assimp-nonbsd.txt is assimp's test/models-nonbsd/README.txt under another name.

		// bench/dragon.obj is the Stanford dragon (dragon_vrip.ply, 437645 vertices and 871414 triangles) rewritten line by line as OBJ for load-time tests, so its entry downloads the dragon archive that the ply region also uses and converts it with awk.
		{
			"category": "models-extra", "name": "bench-dragon", "dest": "bench",
			"url": "http://graphics.stanford.edu/pub/3Dscanrep/dragon/dragon_recon.tar.gz",
			"commands": [
				["sh", "-c", "awk 'BEGIN { print \"# Stanford dragon (dragon_vrip.ply) converted for load-time tests\" } /^element vertex/ { nv = $3 } /^end_header/ { body = 1; next } body && nv > 0 { print \"v\", $1, $2, $3; nv--; next } body { print \"f\", $2 + 1, $3 + 1, $4 + 1 }' {src}/dragon_recon/dragon_vrip.ply > {out}/dragon.obj"]
			],
			"licence": "Stanford 3D Scanning Repository terms: research use, credit required, no commercial use", "redistribute": false, "size": "33 MB",
			"note": "Vertices as 'v x y z' and triangles as 'f a b c' with 1-based indices, 33.4 MB.  The 11 MB download is thrown away afterwards."
		},

