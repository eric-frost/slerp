		{"category": "site-extra", "name": "polyhaven-potted_plant_02", "polyhaven": {"id": "potted_plant_02", "format": "gltf", "res": "1k"}, "dest": "polyhaven/potted_plant_02", "licence": "CC0-1.0 (Poly Haven)", "redistribute": true, "size": "4 MB"},
		{"category": "site-extra", "name": "polyhaven-ship_pinnace", "polyhaven": {"id": "ship_pinnace", "format": "gltf", "res": "1k"}, "dest": "polyhaven/ship_pinnace", "licence": "CC0-1.0 (Poly Haven)", "redistribute": true, "size": "21 MB"},
