// Slerp's public test corpus, fetched into local/assets/<category>/ by tools/fetch-test-assets.ts.
// Field reference: tools/README.md.  "redistribute": false marks files that are fine for local testing but must
// never be committed or published (non-free, unclear or GPL-only licences).
{
	"entries": [
		//region textures
		{
			"category": "textures", "name": "ktx-software",
			"git": {"repo": "https://github.com/KhronosGroup/KTX-Software", "ref": "main", "strip": 2,
				"paths": ["/tests/resources/ktx/", "/tests/resources/ktx2/", "/tests/resources/unicode/", "/tests/resources/basis/"]},
			"licence": "Apache-2.0", "redistribute": true, "size": "40 MB",
			"note": "KTX-Software's own test textures (Git LFS): KTX1 and KTX2, BasisLZ/ETC1S, UASTC, UASTC HDR, ASTC, ETC2/EAC, BC2/BC3, arrays, 3D, cubemaps, zstd, orientation metadata, Unicode names."
		},
		{
			"category": "textures", "name": "ktx-cts",
			"git": {"repo": "https://github.com/KhronosGroup/KTX-Software-CTS", "ref": "main", "strip": 2,
				"paths": ["/clitests/input/ktx2/", "/clitests/input/ktx/", "/clitests/input/ktx2_sample/", "/clitests/input/validate/"]},
			"licence": "Apache-2.0", "redistribute": true, "size": "140 MB",
			"note": "KTX conformance inputs: ktx2/ has one tiny file per vkFormat (every format, 1D/2D/3D, mips, zstd, zlib); ktx2_sample/ has real images (ASTC block sizes, cubemaps, Basis, UASTC); validate/ is invalid files for robustness tests."
		},
		{
			"category": "textures", "name": "dds",
			"git": {"repo": "https://github.com/image-rs/image-dds", "ref": "main", "paths": ["/test-data/images/"], "strip": 2},
			"licence": "MIT OR Apache-2.0", "redistribute": true, "size": "8 MB",
			"note": "DDS samples made with texconv and NVTT: DX9 and DX10 headers, BC1-BC7, BC6H, uncompressed and float formats, cubemaps, a volume texture, ASTC-in-DDS, odd sizes and broken headers."
		},
		{
			"category": "textures", "name": "dds-array-luna",
			"url": "https://media.githubusercontent.com/media/BlurryLight/recipe/master/dx12/resources/textures/treeArray2.dds", "dest": "dds-arrays/treeArray2.dds",
			"licence": "unclear (Frank Luna's DirectX 12 book samples)", "redistribute": false, "size": "0.6 MB",
			"note": "A real 2D texture array: DX10 header, R8G8B8A8_UNORM, three layers with mips."
		},
		{
			"category": "textures", "name": "astc",
			"git": {"repo": "https://github.com/ARM-software/astc-encoder", "ref": "main",
				"paths": ["/Test/Images/Khronos/LDR-RGB/ldr-rgb-diffuse.png", "/Test/Images/Khronos/LDR-RGBA/ldr-rgba-base.png",
					"/Test/Images/Khronos/LDR-XY/ldr-xy-normal1.png", "/Test/Images/Small/LDR-RGBA/ldr-rgba-00.png", "/Test/Images/Small/HDR-RGB/hdr-rgb-00.hdr"]},
			"tool": {"url": "https://github.com/ARM-software/astc-encoder/releases/download/5.7.0/astcenc-5.7.0-linux-x64.zip", "bin": "bin/astcenc-avx2"},
			"commands": [
				["{tool}", "-cs", "{src}/Test/Images/Khronos/LDR-RGB/ldr-rgb-diffuse.png", "{out}/ldr-rgb-diffuse_4x4_srgb.astc", "4x4", "-fast"],
				["{tool}", "-cs", "{src}/Test/Images/Khronos/LDR-RGB/ldr-rgb-diffuse.png", "{out}/ldr-rgb-diffuse_6x6_srgb.astc", "6x6", "-fast"],
				["{tool}", "-cl", "{src}/Test/Images/Khronos/LDR-RGB/ldr-rgb-diffuse.png", "{out}/ldr-rgb-diffuse_8x8_linear.astc", "8x8", "-fast"],
				["{tool}", "-cs", "{src}/Test/Images/Khronos/LDR-RGB/ldr-rgb-diffuse.png", "{out}/ldr-rgb-diffuse_12x12_srgb.astc", "12x12", "-fast"],
				["{tool}", "-cs", "{src}/Test/Images/Khronos/LDR-RGBA/ldr-rgba-base.png", "{out}/ldr-rgba-base_5x5_srgb.astc", "5x5", "-fast"],
				["{tool}", "-cs", "{src}/Test/Images/Khronos/LDR-RGBA/ldr-rgba-base.png", "{out}/ldr-rgba-base_10x6_srgb.astc", "10x6", "-fast"],
				["{tool}", "-cl", "{src}/Test/Images/Khronos/LDR-XY/ldr-xy-normal1.png", "{out}/ldr-xy-normal1_6x6_normal.astc", "6x6", "-fast", "-normal"],
				["{tool}", "-cs", "{src}/Test/Images/Small/LDR-RGBA/ldr-rgba-00.png", "{out}/ldr-rgba-00_8x5_srgb.astc", "8x5", "-medium"],
				["{tool}", "-ch", "{src}/Test/Images/Small/HDR-RGB/hdr-rgb-00.hdr", "{out}/hdr-rgb-00_6x6_hdr.astc", "6x6", "-fast"],
				["{tool}", "-cH", "{src}/Test/Images/Small/HDR-RGB/hdr-rgb-00.hdr", "{out}/hdr-rgb-00_4x4_hdr-alpha.astc", "4x4", "-fast"]
			],
			"licence": "MIT (glTF-Asset-Generator images) / CC0 (HDRI Haven)", "redistribute": true, "size": "10 MB",
			"note": "Raw .astc files (16-byte header) encoded locally with ARM's astcenc: LDR sRGB and linear, normal maps, block sizes 4x4 to 12x12, HDR and HDR-with-alpha profiles."
		},
		//endregion

