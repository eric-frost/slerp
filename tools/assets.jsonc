		{"category": "roblox", "name": "rbx-dom-bench", "git": {"repo": "https://github.com/rojo-rbx/rbx-dom", "ref": "master", "paths": ["/rbx_binary/benches/files/"], "strip": 4}, "licence": "MIT (rbx-dom); Miner's Haven is Apache-2.0 (berezaa/minershaven)", "redistribute": true, "size": "8 MB", "note": "rbx_binary's benchmark files: Miner's Haven (61,000 instances, 1,015 unions with collision hulls, 1,249 mesh parts) and folder/part stress models."},
		{"category": "roblox-extra", "name": "open-game-eval", "git": {"repo": "https://github.com/Roblox/open-game-eval", "ref": "main", "paths": ["*.rbxl", "*.rbxm", "/LICENSE*"], "strip": 0}, "licence": "MIT (Roblox)", "redistribute": true, "size": "22 MB", "note": "Roblox's Studio templates (Castle, village, racing, modern_city, laser_tag, pirate_island, ...): smooth terrain, unions, 13,000 mesh parts, spawn locations."},
		{"category": "roblox-extra", "name": "creator-docs", "git": {"repo": "https://github.com/Roblox/creator-docs", "ref": "main", "paths": ["*.rbxl", "*.rbxm", "*.rbxlx", "/LICENSE*"], "strip": 0}, "licence": "CC-BY-4.0 (docs) and MIT (code); attribute", "redistribute": true, "size": "9 MB", "note": "Places and models from Roblox's documentation; brooklyn_soccer holds 9,000 mesh parts with CSGPHS version 8 hulls."},
