		//region usd-extra
		// Not fetched: usd-extra/generated/forest.usdc (250,000 point-instanced trees), which crates/materials/tools/make-usd-fixtures.py writes
		// with Pixar's usd-core when given that folder.  blender-exports runs blender.org's Linux build, since Ubuntu's Blender is built without USD
		// (crates/materials/tools/blender-usd-export.py does the same export by hand).
		{
			"category": "usd-extra", "name": "openusd-skel", "dest": "openusd-skel",
			"git": {"repo": "https://github.com/PixarAnimationStudios/OpenUSD", "ref": "release",
				"paths": ["/LICENSE.txt", "/pxr/usd/usdSkel/testenv/testUsdSkelBakeSkinning/",
					"/pxr/usdImaging/usdImagingGL/testenv/testUsdImagingGLUsdSkel/*.usda",
					"/pxr/usdImaging/usdImagingGL/testenv/testUsdImagingGLSkelBlendShapes/*.usda",
					"/pxr/usdImaging/usdImagingGL/testenv/testUsdImagingGLSkelSkinning/*.usda"]},
			"commands": [
				["cp", "-r", "{src}/pxr/usd/usdSkel/testenv/testUsdSkelBakeSkinning", "{out}/bake-skinning"],
				["cp", "-r", "{src}/pxr/usdImaging/usdImagingGL/testenv/testUsdImagingGLUsdSkel", "{out}/imaging-usdskel"],
				["cp", "-r", "{src}/pxr/usdImaging/usdImagingGL/testenv/testUsdImagingGLSkelBlendShapes", "{out}/imaging-blendshapes"],
				["cp", "-r", "{src}/pxr/usdImaging/usdImagingGL/testenv/testUsdImagingGLSkelSkinning", "{out}/imaging-skinning"],
				["cp", "{src}/LICENSE.txt", "{out}/LICENSE.txt"]
			],
			"licence": "TOST-1.0 (OpenUSD: Apache-2.0 with a different trademark clause)", "redistribute": true, "size": "1.9 MB",
			"note": "Pixar's UsdSkel tests: linear and dual-quaternion skinning, blend shapes (sparse, with normal offsets and inbetweens), an arm and a two-bend rig, with UsdSkel's own baked points (bake-skinning/baseline/) to compare skinning against."
		},
		{
			"category": "usd-extra", "name": "openusd-instancers", "dest": "openusd-instancers",
			"git": {"repo": "https://github.com/PixarAnimationStudios/OpenUSD", "ref": "release",
				"paths": ["/LICENSE.txt", "/pxr/usdImaging/usdImagingGL/testenv/testUsdImagingGLPointInstancer/*.usda",
					"/pxr/usdImaging/usdImagingGL/testenv/testUsdImagingGLMaterialsAndInstancers/*.usda",
					"/pxr/usdImaging/bin/testusdview/testenv/testUsdviewPointInstancerVariant/test.usda",
					"/pxr/usd/usdGeom/testenv/testUsdGeomPointInstancer/*.usda"]},
			"commands": [
				["cp", "-r", "{src}/pxr/usdImaging/usdImagingGL/testenv/testUsdImagingGLPointInstancer", "{out}/imaging-pointinstancer"],
				["cp", "-r", "{src}/pxr/usdImaging/usdImagingGL/testenv/testUsdImagingGLMaterialsAndInstancers", "{out}/imaging-materials"],
				["cp", "{src}/pxr/usdImaging/bin/testusdview/testenv/testUsdviewPointInstancerVariant/test.usda", "{out}/usdview-variant.usda"],
				["cp", "-r", "{src}/pxr/usd/usdGeom/testenv/testUsdGeomPointInstancer", "{out}/usdgeom-pointinstancer"],
				["cp", "{src}/LICENSE.txt", "{out}/LICENSE.txt"]
			],
			"licence": "TOST-1.0 (OpenUSD: Apache-2.0 with a different trademark clause)", "redistribute": true, "size": "0.1 MB",
			"note": "Pixar's PointInstancer tests: masks and invisible ids, nested instancers, instancers inside native instances and the reverse, prototypes outside the instancer, cycles, half and float orientations, time-varying attributes, bad schema input."
		},
		{
			"category": "usd-extra", "name": "blender-exports", "dest": "blender",
			"git": {"repo": "https://github.com/KhronosGroup/glTF-Blender-IO", "ref": "main",
				"paths": ["/LICENSE.txt", "/tests/scenes/03_skinned_cylinder.blend", "/tests/scenes/28_shapekeys_anim.blend",
					"/tests/scenes/03_all_animations.blend", "/tests/scenes/parent_is_skined.blend"]},
			"tool": {"url": "https://download.blender.org/release/Blender5.0/blender-5.0.1-linux-x64.tar.xz", "bin": "blender-5.0.1-linux-x64/blender"},
			"commands": [
				["{tool}", "-b", "{src}/tests/scenes/03_skinned_cylinder.blend", "--factory-startup", "--python-exit-code", "1", "--python-expr", "import bpy, sys; bpy.ops.wm.usd_export(filepath=sys.argv[-1], export_animation=True, export_armatures=True, export_shapekeys=True)", "--", "{out}/03_skinned_cylinder.usdc"],
				["{tool}", "-b", "{src}/tests/scenes/28_shapekeys_anim.blend", "--factory-startup", "--python-exit-code", "1", "--python-expr", "import bpy, sys; bpy.ops.wm.usd_export(filepath=sys.argv[-1], export_animation=True, export_armatures=True, export_shapekeys=True)", "--", "{out}/28_shapekeys_anim.usdc"],
				["{tool}", "-b", "{src}/tests/scenes/03_all_animations.blend", "--factory-startup", "--python-exit-code", "1", "--python-expr", "import bpy, sys; bpy.ops.wm.usd_export(filepath=sys.argv[-1], export_animation=True, export_armatures=True, export_shapekeys=True)", "--", "{out}/03_all_animations.usdc"],
				["{tool}", "-b", "{src}/tests/scenes/parent_is_skined.blend", "--factory-startup", "--python-exit-code", "1", "--python-expr", "import bpy, sys; bpy.ops.wm.usd_export(filepath=sys.argv[-1], export_animation=True, export_armatures=True, export_shapekeys=True)", "--", "{out}/parent_is_skined.usdc"],
				["cp", "{src}/LICENSE.txt", "{out}/LICENSE.txt"]
			],
			"licence": "Apache-2.0 (glTF-Blender-IO's test scenes)", "redistribute": true, "size": "0.2 MB (and a 374 MB Blender download to make them)",
			"note": "glTF-Blender-IO's rigged test scenes exported as USD by Blender 5.0.1: an animated skinned cylinder, animated shape keys (UsdSkel blend shapes driven by a SkelAnimation), object animations, and a skinned parent with twelve meshes and two skeletons."
		},
