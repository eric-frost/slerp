		//region dicom-extra (NEMA's DICOM sample sets, which have no stated licence: local testing only)
		// NEMA publishes these on an FTP server, which the fetcher's own downloader (HTTP only) cannot read, so the entries run curl and tar.  The folder's SOURCES.md and NOT-REDISTRIBUTABLE are hand-written notes, not fetched.
		{
			"category": "dicom-extra", "name": "nema-wg04",
			"commands": [
				["curl", "-fsS", "--retry", "3", "-o", "{out}/j2k.tar", "ftp://medical.nema.org/medical/dicom/DataSets/WG04/compsamples_j2k.tar"],
				["curl", "-fsS", "--retry", "3", "-o", "{out}/jpeg.tar", "ftp://medical.nema.org/medical/dicom/DataSets/WG04/compsamples_jpeg.tar"],
				["curl", "-fsS", "--retry", "3", "-o", "{out}/jpegls.tar", "ftp://medical.nema.org/medical/dicom/DataSets/WG04/compsamples_jpegls.tar"],
				["curl", "-fsS", "--retry", "3", "-o", "{out}/refanddir.tar.bz2", "ftp://medical.nema.org/medical/dicom/DataSets/WG04/compsamples_refanddir.tar.bz2"],
				["curl", "-fsS", "--retry", "3", "-o", "{out}/compsamples_README.txt", "ftp://medical.nema.org/medical/dicom/DataSets/WG04/compsamples_README.txt"],
				["tar", "-xf", "{out}/j2k.tar", "-C", "{out}"],
				["tar", "-xf", "{out}/jpeg.tar", "-C", "{out}"],
				["tar", "-xf", "{out}/jpegls.tar", "-C", "{out}"],
				["tar", "-xjf", "{out}/refanddir.tar.bz2", "-C", "{out}"],
				["sh", "-c", "rm -f {out}/*.tar {out}/*.tar.bz2 {out}/IMAGES/*/VL4_* {out}/IMAGES/*/VL5_*"]
			],
			"licence": "no stated licence (NEMA WG04 compressed samples by David Clunie, 2004)", "redistribute": false, "size": "190 MB",
			"note": "Every image (CT1, CT2, MG1, MR1-MR4, NM1, RG1-RG3, SC1, US1, VL1-VL6, XA1) uncompressed in IMAGES/REF and compressed as JPEG lossless (JPLL), 12-bit lossy JPEG (JPLY), JPEG-LS (JLSL, JLSN) and JPEG 2000 (J2KR, J2KI), with the DICOMDIR.  The visible-light photos VL4 and VL5 (60 MB) are deleted after unpacking, as on the machine that collected the set."
		},
		{
			"category": "dicom-extra", "name": "nema-wg12-us", "dest": "nema-wg12-us",
			"commands": [
				["curl", "-fsS", "--retry", "3", "-o", "{out}/HP_Agilent_00000213", "ftp://medical.nema.org/medical/dicom/DataSets/WG12/HP_Agilent/00000213"],
				["curl", "-fsS", "--retry", "3", "-o", "{out}/HP_Agilent_10200901", "ftp://medical.nema.org/medical/dicom/DataSets/WG12/HP_Agilent/10200901"],
				["curl", "-fsS", "--retry", "3", "-o", "{out}/HP_Agilent_10200904", "ftp://medical.nema.org/medical/dicom/DataSets/WG12/HP_Agilent/10200904"],
				["curl", "-fsS", "--retry", "3", "-o", "{out}/Philips_HDI5000_2XV8RLGL", "ftp://medical.nema.org/medical/dicom/DataSets/WG12/Philips_Ultrasound/HDI_5000/2XV8RLGL"],
