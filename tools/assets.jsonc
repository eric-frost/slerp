		//region gltf
		{
			"category": "gltf", "name": "khronos",
			"git": {"repo": "https://github.com/KhronosGroup/glTF-Sample-Assets", "ref": "main", "strip": 1, "paths": [
				"/Models/Box/", "/Models/BoxTextured/", "/Models/Duck/", "/Models/DamagedHelmet/", "/Models/FlightHelmet/", "/Models/Sponza/",
				"/Models/MetalRoughSpheres/", "/Models/NormalTangentTest/", "/Models/TextureTransformTest/", "/Models/TextureSettingsTest/",
				"/Models/AlphaBlendModeTest/", "/Models/AnimatedMorphCube/", "/Models/MorphPrimitivesTest/", "/Models/MorphStressTest/",
				"/Models/SimpleSkin/", "/Models/RiggedSimple/", "/Models/RiggedFigure/", "/Models/CesiumMan/", "/Models/Fox/", "/Models/BrainStem/",
				"/Models/InterpolationTest/", "/Models/SimpleSparseAccessor/", "/Models/ClearCoatTest/", "/Models/SpecularTest/", "/Models/IORTestGrid/",
				"/Models/EmissiveStrengthTest/", "/Models/UnlitTest/", "/Models/VertexColorTest/", "/Models/MultiUVTest/",
				"/Models/Avocado/", "/Models/Lantern/", "/Models/MeshoptCubeTest/", "/Models/DragonAttenuation/", "/Models/StainedGlassLamp/",
				"/Models/ChronographWatch/", "/Models/AnisotropyBarnLamp/", "/Models/CarConcept/", "/Models/ToyCar/", "/Models/SheenChair/",
				"/Models/Suzanne/", "/Models/TextureCoordinateTest/", "/Models/OrientationTest/", "/Models/AnimatedCube/", "/Models/BoxAnimated/",
				"/Models/RecursiveSkeletons/", "/Models/NegativeScaleTest/", "/Models/TransmissionTest/"
			]},
			"licence": "per model, in each folder's LICENSE.md: mostly CC0 or CC-BY-4.0, but DamagedHelmet (CC-BY-NC), Duck (SCEA), Sponza (CRYENGINE), BrainStem (Poser EULA) and DragonAttenuation (Stanford) are restricted", "redistribute": false, "size": "520 MB",
			"note": "Khronos sample models with all their variants: glTF, GLB, embedded, Draco, Meshopt (BrainStem, DragonAttenuation, MeshoptCubeTest), Quantized (Duck, Avocado, Lantern, AnimatedMorphCube), KTX-BasisU (FlightHelmet, StainedGlassLamp, ChronographWatch, AnisotropyBarnLamp, CarConcept)."
		},
		{"category": "gltf", "name": "three-facecap", "url": "https://raw.githubusercontent.com/mrdoob/three.js/dev/examples/models/gltf/facecap.glb", "dest": "three/facecap.glb", "licence": "unclear (three.js example; Bannaflak face capture)", "redistribute": false, "size": "0.3 MB", "note": "Meshopt + KTX2 (Basis) compressed head with 52 ARKit blend shapes and animation."},
		{"category": "gltf", "name": "three-coffeemat", "url": "https://raw.githubusercontent.com/mrdoob/three.js/dev/examples/models/gltf/coffeemat.glb", "dest": "three/coffeemat.glb", "licence": "unclear (three.js example)", "redistribute": false, "size": "4.8 MB", "note": "gltfpack output: Meshopt + KTX2 textures."},
		{"category": "gltf", "name": "three-littlesttokyo", "url": "https://raw.githubusercontent.com/mrdoob/three.js/dev/examples/models/gltf/LittlestTokyo.glb", "dest": "three/LittlestTokyo.glb", "licence": "CC-BY-4.0 (Glen Fox)", "redistribute": true, "size": "4.1 MB", "note": "Draco compressed, animated scene."},
		{"category": "gltf", "name": "three-readyplayerme", "url": "https://raw.githubusercontent.com/mrdoob/three.js/dev/examples/models/gltf/readyplayer.me.glb", "dest": "three/readyplayer.me.glb", "licence": "unclear (Ready Player Me avatar)", "redistribute": false, "size": "1.8 MB", "note": "Avatar with ARKit and viseme blend shapes."},
		{"category": "gltf", "name": "three-xbot", "url": "https://raw.githubusercontent.com/mrdoob/three.js/dev/examples/models/gltf/Xbot.glb", "dest": "three/Xbot.glb", "licence": "Mixamo (Adobe terms)", "redistribute": false, "size": "2.9 MB", "note": "Mixamo skeleton with several animation clips and additive poses."},
		{"category": "gltf", "name": "three-soldier", "url": "https://raw.githubusercontent.com/mrdoob/three.js/dev/examples/models/gltf/Soldier.glb", "dest": "three/Soldier.glb", "licence": "Mixamo (Adobe terms)", "redistribute": false, "size": "2.2 MB", "note": "Skinned Mixamo character with idle/walk/run clips."},
