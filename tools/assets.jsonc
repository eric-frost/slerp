		// Proposed block for tools/assets.jsonc: test files for the DXF and Rhino .3dm readers (crates/cad).
		// Paste it before the closing bracket of "entries".  Everything lands in local/assets/cad-extra/{dxf,3dm}/<folder>/ with the
		// repository's own sub-paths (the layout described in local/assets/cad-extra/SOURCES.md).  Entries with "redistribute": false are local only.
		// The folders dxf/generated and 3dm/generated are not fetched: crates/cad/tools/make-dxf-samples.py and make-3dm-samples.py write them.
		// dxf/bogota (CC-BY-4.0) is not an entry either: it is a 22 MB prefix of the 268 MB Licencia.dxf from
		// https://datosabiertos.bogota.gov.co/dataset/913bae91-0f63-4162-872a-163e94197c98/resource/09223a7b-888e-4e00-8b3e-47b72d2cab49/download/licencia.zip
		// made with crates/cad/tools/excerpt-large-dxf.py (`python excerpt-large-dxf.py Licencia.dxf Licencia_excerpt.dxf 22000000`).
		// Git LFS repositories (rhinousd, revit-test-datasets, sourcecity, integral-timber-joints, pitchplease, groundhog, mx-testing, rhinocodetests,
		// three-windmill-scene) list their files one by one so that only those objects are downloaded.
		//region cad-extra DXF
		{
			"category": "cad-extra", "name": "dxf-ezdxf", "dest": "dxf/ezdxf",
			"git": {"repo": "https://github.com/mozman/ezdxf", "ref": "master", "strip": 0,
				"paths": [
				"/examples_dxf/**/*.dxf",
				"/integration_tests/data/*.[dD][xX][fF]",
				"/exploration/**/*.dxf",
				"/examples/**/*.dxf",
				"/tests/**/*.dxf",
				"/docs/source/tutorials/src/geo/*.dxf"
			]},
			"licence": "MIT", "redistribute": true, "size": "15 MB",
			"note": "ezdxf's own example drawings and test data: AC1003 to R2018 (AutoCAD, BricsCAD, LibreCAD, Leica Disto, hand-edited), binary DXF R12/R13/R14/R2000, tables, MTEXT with inline codes and columns, hatches, images, wipeouts, ACIS 3DSOLIDs, viewports, recover-mode broken files."
		},
		{
			"category": "cad-extra", "name": "dxf-dxf-rs", "dest": "dxf/dxf-rs",
			"git": {"repo": "https://github.com/IxMilia/dxf-rs", "ref": "main", "strip": 2,
				"paths": ["/src/misc_tests/*.dxf"]},
			"licence": "MIT", "redistribute": true, "size": "1 KB",
			"note": "One tiny binary DXF (a diamond)."
		},
		{
			"category": "cad-extra", "name": "dxf-netdxf", "dest": "dxf/netdxf",
			"git": {"repo": "https://github.com/haplokuon/netDxf", "ref": "master", "strip": 1,
				"paths": ["/TestDxfDocument/*.dxf"]},
			"licence": "MIT", "redistribute": true, "size": "742 KB",
			"note": "netDxf's all-entities sample as ASCII and as binary DXF, both R2018 (AC1032): many entity types, gradient hatch, polyface and polygon meshes, MLINE, SHAPE, PDF underlay, RAY/XLINE, MESH."
		},
		{
			"category": "cad-extra", "name": "dxf-dxf-parser", "dest": "dxf/dxf-parser",
			"git": {"repo": "https://github.com/gdsestimating/dxf-parser", "ref": "master", "strip": 0,
				"paths": ["/samples/data/*.dxf", "/test/data/*.dxf"]},
			"licence": "MIT", "redistribute": true, "size": "4 MB",
			"note": "dxf-parser's test files: blocks, splines, polylines, extended data, MTEXT, MULTILEADER, header variables; one 2.7 MB AutoCAD 2013 detail drawing."
		},
		{
			"category": "cad-extra", "name": "dxf-three-dxf", "dest": "dxf/three-dxf",
			"git": {"repo": "https://github.com/gdsestimating/three-dxf", "ref": "master", "strip": 2,
				"paths": ["/sample/data/*.dxf"]},
			"licence": "MIT", "redistribute": true, "size": "135 KB",
			"note": "three-dxf's demo drawing (R2018)."
		},
		{
			"category": "cad-extra", "name": "dxf-jamesbremner-dxf-viewer", "dest": "dxf/jamesbremner-dxf-viewer",
			"git": {"repo": "https://github.com/JamesBremner/DXF_Viewer", "ref": "master", "strip": 1,
				"paths": ["/dxf/*.dxf", "/dxf/*.DXF"]},
			"licence": "MIT (repository); the sample drawings are unattributed user files", "redistribute": false, "size": "2 MB",
			"note": "An R12 gear drawing, B-spline cases (clamped and unclamped), a Chinese-codepage (ANSI_936) R14 drawing (tid45), and tiny hand-written one-entity files.  The repository is MIT but the larger drawings look like user submissions of unstated origin, so they stay local-only."
		},
		{
			"category": "cad-extra", "name": "dxf-clover", "dest": "dxf/clover",
			"git": {"repo": "https://github.com/CopterExpress/clover", "ref": "master", "strip": 3,
				"paths": ["/docs/assets/dxf/deck.dxf", "/docs/assets/dxf/arm.dxf", "/docs/assets/dxf/reinforced_plate_base.dxf"]},
			"licence": "MIT", "redistribute": true, "size": "1 MB",
			"note": "Laser-cut drone parts saved by a Russian AutoCAD (R2013 and R2018, $DWGCODEPAGE ANSI_1251, Cyrillic layout and layer names stored as UTF-8)."
		},
		{
			"category": "cad-extra", "name": "dxf-reviung", "dest": "dxf/reviung",
			"git": {"repo": "https://github.com/gtips/reviung", "ref": "master", "strip": 0,
