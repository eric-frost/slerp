		//endregion
		//region blend-extra (Blender scenes for crates/blend: glTF-Blender-IO's test scenes, Blender's demo files, Poly Haven models)
		// Not fetched: generated/ holds scenes that crates/blend/tools/make-test-scenes.py writes with Blender (blender -b --factory-startup
		// --python make-test-scenes.py -- OUT_DIR gives modifiers.blend, modifiers-plain.blend and scene.blend) and Blender's own exports of them
		// (.glb and .json, from crates/blend/tools/blender-reference.py), so they carry no third-party licence.  ref/ holds the same kind of
		// reference exports (.glb, .json and .log, 965 MB) that blender-reference.py wrote for every other .blend file in this folder; they are
		// derived from the files below and are rebuilt with Blender, not downloaded.  All 331 files of demos/ and all of polyhaven/ are fetched.
		// gltf-blender-io/ keeps 100 of the repository's 228 test scenes, so its paths are listed one by one.  The entry copies them out of the
		// checkout with commands (and the repository's root LICENSE.txt beside them), because a git entry's strip would drop the root file.
		{
			"category": "blend-extra", "name": "gltf-blender-io", "dest": "gltf-blender-io",
